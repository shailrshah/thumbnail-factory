# WebSocket upgrades pass through (Vite HMR in dev); plain requests keep "close".
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_name _;

    # Docker's embedded DNS. Upstreams are set via variables so nginx resolves them per
    # request: it starts even if a service is down and follows containers that are recreated.
    resolver 127.0.0.11 valid=10s ipv6=off;

    client_max_body_size 10m;

    location /api/ {
        set $backend http://backend:8000;
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /media/ {
        alias /data/;
        # A job's thumbnails never change once written.
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location / {
        set $frontend http://${FRONTEND_UPSTREAM};
        proxy_pass $frontend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
